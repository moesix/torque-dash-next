{
  "name": "torque-dash-next",
  "version": "2.2.7",
  "description": "Modernization of torque-dash: Express/Sequelize/Postgres + TimescaleDB + React SPA",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "test": "node --test test/ && node scripts/checkMirrors.js && node scripts/checkTestIntegrity.js",
    "test:coverage": "c8 node --test test/ && node scripts/checkMirrors.js && node scripts/checkTestIntegrity.js",
    "test:integration": "node --test --test-concurrency=1 --test-force-exit integration/*.test.js",
    "verify": "npm test && npm run lint && cd apps/frontend && npm test && npx tsc --noEmit",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "nanoid": "^3.3.18",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "sequelize": "^6.37.8"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "node -c"
    ],
    "apps/frontend/**/*.{ts,tsx}": [
      "bash -c 'cd apps/frontend && npx --no-install tsc --noEmit'"
    ]
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "qs": "^6.16.0"
  }
}
