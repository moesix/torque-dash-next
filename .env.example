# =============================================================================
# torque-dash-next Production Configuration
# =============================================================================
# Copy this file to .env and configure your settings.
# Then run: docker compose up -d
#
# IMPORTANT: The app will NOT start without the required variables below.
# Generate secure values with:
#   openssl rand -base64 24  # for POSTGRES_PASSWORD
#   openssl rand -hex 24     # for SESSION_KEYS
#   openssl rand -hex 24     # for UPLOAD_API_TOKEN (required for production)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Runtime (optional — informational)
# -----------------------------------------------------------------------------
# NODE_ENV=production skips the app-internal sequelize.sync() in app.js
# (migrations own TimescaleDB DDL). NOTE: the Docker image CMD still runs an
# idempotent sequelize.sync() bootstrap before scripts/migrate.js on EVERY
# boot, regardless of NODE_ENV — base tables stay sync-maintained; migrations
# remain the source of truth for TimescaleDB-specific DDL (hypertable,
# continuous aggregate).
# NODE_ENV=production

# PORT: backend HTTP listen port (app default 3000; docker-compose pins 3000).
# PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL/TimescaleDB credentials. Use the same values for all three.
POSTGRES_DB=torquedash
POSTGRES_USER=torquedash
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# Session Security (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
# For key rotation, use comma-separated values: key1,key2,key3
SESSION_KEYS=CHANGE_ME_TO_A_RANDOM_HEX_STRING

# -----------------------------------------------------------------------------
# Upload Authentication (REQUIRED for production)
# -----------------------------------------------------------------------------
# Bearer token required for Torque Pro uploads.
# Generate with: openssl rand -hex 24
# Torque Pro must send: Authorization: Bearer <this-token>
#
# REQUIRED for production (2026 baseline). Set it here OR generate one from
# the Settings page in the web UI after logging in. If set here, the env value
# overrides the UI and locks the Settings page (generate/clear are disabled
# while env-managed).
UPLOAD_API_TOKEN=

# -----------------------------------------------------------------------------
# Cookie Settings
# -----------------------------------------------------------------------------
# Set to true behind HTTPS reverse proxy (recommended for production).
# SameSite is DERIVED from COOKIE_SECURE in app.js ('none' when COOKIE_SECURE
# is true, otherwise 'lax') — there is no separate COOKIE_SAMESITE override,
# and a stale value would be silently ignored, so it has been removed. A
# cross-origin SPA requires sameSite:'none' + Secure (COOKIE_SECURE=true).
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Upload rate limit (per IP)
UPLOAD_RATE_LIMIT_MAX=600
UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# Auth rate limit (login/register per IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Write rate limit (settings mutations per IP)
WRITE_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_WINDOW_MS=60000

# Read rate limit (all other /api routes per IP)
READ_RATE_LIMIT_MAX=600
READ_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Registration
# -----------------------------------------------------------------------------
# Set to true to disable public sign-ups
# DISABLE_REGISTRATION=true

# -----------------------------------------------------------------------------
# BYOK LLM Configuration
# -----------------------------------------------------------------------------
# Encryption key for API keys stored in the database.
# Generate with: openssl rand -hex 32
# REQUIRED if you want to use AI analysis features.
LLM_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CORS & Origin
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS (e.g. https://torque.automata.my)
# Leave empty to disable CORS (same-origin only).
CORS_ORIGINS=

# The public URL of your deployment (used for CSRF protection).
# e.g. https://torque.automata.my
PUBLIC_ORIGIN=

# -----------------------------------------------------------------------------
# AI Analysis Rate Limiting
# -----------------------------------------------------------------------------
# Rate limit for AI analysis endpoints (per IP)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
